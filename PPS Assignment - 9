#include <stdio.h>
#include <string.h>

#define MAX_PATH 260
#define BUF_SIZE 4096

static void strip_newline(char *str) {
    size_t len = strlen(str);
    if (len > 0 && str[len - 1] == '\n') {
        str[len - 1] = '\0';
    }
}

static void read_path(const char *prompt, char *buf, size_t size) {
    printf("%s", prompt);
    if (fgets(buf, (int)size, stdin) != NULL) {
        strip_newline(buf);
    } else {
        buf[0] = '\0';
    }
}

int main(void) {
    char src_path[MAX_PATH], dst_path[MAX_PATH];
    unsigned char buffer[BUF_SIZE];
    FILE *src = NULL, *dst = NULL;
    size_t bytes_read;
    int status = 0;

    read_path("Enter source file path: ", src_path, sizeof(src_path));
    read_path("Enter destination file path: ", dst_path, sizeof(dst_path));

    if (src_path[0] == '\0' || dst_path[0] == '\0') {
        printf("Error: File paths cannot be empty.\n");
        return 1;
    }

    if (strcmp(src_path, dst_path) == 0) {
        printf("Error: Source and destination paths must be different.\n");
        return 1;
    }

    src = fopen(src_path, "rb");
    if (src == NULL) {
        perror("Error opening source file");
        return 1;
    }

    dst = fopen(dst_path, "wb");
    if (dst == NULL) {
        perror("Error opening destination file");
        fclose(src);
        return 1;
    }

    while ((bytes_read = fread(buffer, 1, sizeof(buffer), src)) > 0) {
        size_t bytes_written = fwrite(buffer, 1, bytes_read, dst);
        if (bytes_written != bytes_read) {
            perror("Error writing to destination file");
            status = 1;
            break;
        }
    }

    if (ferror(src)) {
        perror("Error reading from source file");
        status = 1;
    }

    if (fclose(src) != 0) {
        perror("Error closing source file");
        status = 1;
    }

    if (fclose(dst) != 0) {
        perror("Error closing destination file");
        status = 1;
    }

    if (status == 0) {
        printf("File copied successfully from '%s' to '%s'.\n", src_path, dst_path);
    }

    return status;
}
