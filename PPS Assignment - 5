#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_LEN 200

static void strip_newline(char *str) {
    size_t len = strlen(str);
    if (len > 0 && str[len - 1] == '\n') {
        str[len - 1] = '\0';
    }
}

static void clear_input_buffer(void) {
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {
        /* discard extra input */
    }
}

static void read_line(const char *prompt, char *buf, size_t size) {
    printf("%s", prompt);
    if (fgets(buf, (int)size, stdin) != NULL) {
        strip_newline(buf);
    } else {
        buf[0] = '\0';
    }
}

static void reverse_string(char *str) {
    size_t i = 0;
    size_t j = strlen(str);
    if (j == 0) return;
    j--;
    while (i < j) {
        char tmp = str[i];
        str[i] = str[j];
        str[j] = tmp;
        i++;
        j--;
    }
}

static void to_upper_string(char *str) {
    for (size_t i = 0; str[i] != '\0'; i++) {
        str[i] = (char)toupper((unsigned char)str[i]);
    }
}

static void to_lower_string(char *str) {
    for (size_t i = 0; str[i] != '\0'; i++) {
        str[i] = (char)tolower((unsigned char)str[i]);
    }
}

int main(void) {
    int choice;
    char s1[MAX_LEN], s2[MAX_LEN], result[MAX_LEN * 2];

    do {
        printf("\n=== String Operations Menu ===\n");
        printf("1. Length of a string\n");
        printf("2. Copy string (s1 -> copied)\n");
        printf("3. Concatenate two strings (s1 + s2)\n");
        printf("4. Compare two strings (s1 vs s2)\n");
        printf("5. Reverse a string\n");
        printf("6. Convert string to UPPERCASE\n");
        printf("7. Convert string to lowercase\n");
        printf("0. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please enter a number.\n");
            clear_input_buffer();
            choice = -1;
            continue;
        }
        clear_input_buffer();

        switch (choice) {
            case 1:
                read_line("Enter a string: ", s1, sizeof(s1));
                printf("Length: %zu\n", strlen(s1));
                break;

            case 2:
                read_line("Enter source string: ", s1, sizeof(s1));
                strcpy(result, s1);
                printf("Copied string: %s\n", result);
                break;

            case 3:
                read_line("Enter first string: ", s1, sizeof(s1));
                read_line("Enter second string: ", s2, sizeof(s2));
                if (strlen(s1) + strlen(s2) >= sizeof(result)) {
                    printf("Error: Combined string exceeds buffer size.\n");
                } else {
                    strcpy(result, s1);
                    strcat(result, s2);
                    printf("Concatenated string: %s\n", result);
                }
                break;

            case 4: {
                read_line("Enter first string: ", s1, sizeof(s1));
                read_line("Enter second string: ", s2, sizeof(s2));
                int cmp = strcmp(s1, s2);
                if (cmp == 0) {
                    printf("Strings are equal.\n");
                } else if (cmp < 0) {
                    printf("\"%s\" comes before \"%s\".\n", s1, s2);
                } else {
                    printf("\"%s\" comes after \"%s\".\n", s1, s2);
                }
                break;
            }

            case 5:
                read_line("Enter a string: ", s1, sizeof(s1));
                reverse_string(s1);
                printf("Reversed string: %s\n", s1);
                break;

            case 6:
                read_line("Enter a string: ", s1, sizeof(s1));
                to_upper_string(s1);
                printf("Uppercase: %s\n", s1);
                break;

            case 7:
                read_line("Enter a string: ", s1, sizeof(s1));
                to_lower_string(s1);
                printf("Lowercase: %s\n", s1);
                break;

            case 0:
                printf("Exiting program.\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
                break;
        }
    } while (choice != 0);

    return 0;
}
