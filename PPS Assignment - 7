#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 100
#define NAME_LEN 100

struct Student {
    int roll_no;
    char name[NAME_LEN];
    float marks[3];
    float total;
    float percentage;
    char grade;
    int passed;
};

static void clear_input_buffer(void) {
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {
        /* discard remaining characters on line */
    }
}

static void strip_newline(char *str) {
    size_t len = strlen(str);
    if (len > 0 && str[len - 1] == '\n') {
        str[len - 1] = '\0';
    }
}

static char calculate_grade(float percentage, int passed) {
    if (!passed) {
        return 'F';
    }
    if (percentage >= 90.0f) return 'A';
    if (percentage >= 75.0f) return 'B';
    if (percentage >= 60.0f) return 'C';
    if (percentage >= 50.0f) return 'D';
    return 'E';
}

int main(void) {
    struct Student students[MAX_STUDENTS];
    int n = 0;

    printf("Enter number of students (1 to %d): ", MAX_STUDENTS);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_STUDENTS) {
        printf("Invalid number of students.\n");
        return 1;
    }
    clear_input_buffer();

    for (int i = 0; i < n; i++) {
        printf("\n--- Enter Details for Student %d ---\n", i + 1);

        printf("Roll Number: ");
        if (scanf("%d", &students[i].roll_no) != 1) {
            printf("Invalid roll number.\n");
            return 1;
        }
        clear_input_buffer();

        printf("Full Name: ");
        if (fgets(students[i].name, sizeof(students[i].name), stdin) != NULL) {
            strip_newline(students[i].name);
        } else {
            students[i].name[0] = '\0';
        }

        students[i].total = 0.0f;
        students[i].passed = 1;

        for (int j = 0; j < 3; j++) {
            printf("Marks for Subject %d (out of 100): ", j + 1);
            if (scanf("%f", &students[i].marks[j]) != 1 ||
                students[i].marks[j] < 0.0f ||
                students[i].marks[j] > 100.0f) {
                printf("Invalid marks. Enter a value between 0 and 100.\n");
                return 1;
            }
            students[i].total += students[i].marks[j];
            if (students[i].marks[j] < 40.0f) {
                students[i].passed = 0;
            }
        }
        clear_input_buffer();

        students[i].percentage = students[i].total / 3.0f;
        students[i].grade = calculate_grade(students[i].percentage, students[i].passed);
    }

    printf("\n==================== STUDENT RESULTS ====================\n");
    printf("%-8s %-22s %-8s %-10s %-7s %-8s\n",
           "Roll No", "Name", "Total", "Percent", "Grade", "Status");
    printf("---------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        printf("%-8d %-22s %-8.2f %-9.2f%% %-7c %-8s\n",
               students[i].roll_no,
               students[i].name,
               students[i].total,
               students[i].percentage,
               students[i].grade,
               students[i].passed ? "PASS" : "FAIL");
    }

    return 0;
}
